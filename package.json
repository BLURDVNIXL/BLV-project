{
  "name": "blv-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/core/simulation.test.ts src/core/health.test.ts src/3d/ambiance.test.ts src/3d/avatars.test.ts src/world/playerHouses.test.ts src/world/interiors.test.ts src/world/npcAppearance.test.ts src/world/interiorNpcs.test.ts src/3d/interiorsCollision.test.ts src/world/routing.test.ts src/core/gpsDestinations.test.ts src/world/taxiApproach.test.ts",
    "test:physics": "node physics/test.mjs && npx tsx physics/integration.test.ts",
    "test:world": "npx tsx physics/world.test.ts",
    "test:city": "npx tsx physics/city.test.ts",
    "build:wasm": "bash physics/build.sh",
    "test:e2e": "python3 e2e/drive_city.py"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
